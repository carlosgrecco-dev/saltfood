# Copie este arquivo para ".env" e preencha depois de importar supabase/migrations/0001_init.sql
# em um projeto Supabase (Settings > API).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# API própria (Express + Prisma) usada pela área de Super Admin
VITE_API_URL=http://localhost:3001
